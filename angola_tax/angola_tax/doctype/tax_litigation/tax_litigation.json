   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "tax_type",
   "label": "Tax Type",
   "fieldtype": "Link",
   "options": "Tax Type",
   "reqd": 1
  },
  {
   "fieldname": "amount_under_dispute",
   "label": "Amount Under Dispute",
   "fieldtype": "Currency"
  },
  {
   "fieldname": "undisputed_amount",
   "label": "Undisputed Amount",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
